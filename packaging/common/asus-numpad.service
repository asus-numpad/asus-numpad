[Unit]
Description=ASUS NumberPad (touchpad numpad) userspace driver
Documentation=man:asus-numpad(1)
# 用户级实例：随登录会话起落，不需要 root。
# 触摸板节点在 udev 处理完后才稳定，否则会抢在 HID 初始化之前 open 失败。
After=default.target
ConditionPathExists=/dev/input
# 只在真机上跑：虚拟机 / 无触摸板的机器直接跳过，避免服务一直重启
ConditionPathExistsGlob=/dev/input/event*

[Service]
Type=simple
ExecStart=/usr/bin/asus-numpad run
Restart=on-failure
RestartSec=2s
# 权限来源是 udev 的 TAG+="uaccess"（seat 内活动会话对触摸板 event 节点、
# uinput、hidraw 背光通道天然可读写），因此这里不再需要 root。
# 注意：用户级服务不能提实时优先级 / 改 OOM 权重（要 CAP_SYS_NICE），
# 事件处理本身是 125Hz 的用户态循环，默认调度类足够。

# ---- 加固（都不需要特权，用户级可用）----
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
