# shellcheck shell=bash
# 由 pacman 在安装/升级后调用（PKGBUILD 里 install= 指向本文件）。
# 不自动 enable 服务：Arch 的惯例是让用户自己决定开机自启。
post_install() {
    cat <<'EOF'
--
asus-numpad 已安装。

1) 确认机型受支持：
       asus-numpad --probe

2) 手动试跑（前台，Ctrl+C 退出）：
       sudo asus-numpad --verbose

3) 开机自启：
       sudo systemctl enable --now asus-numpad

配置文件在 /etc/asus-numpad/asus-numpad.json，改动后重启服务生效。
--
EOF
}

post_upgrade() {
    post_install
    # 升级后重新拉起，避免旧进程继续跑旧二进制
    if systemctl is-active --quiet asus-numpad 2>/dev/null; then
        systemctl try-restart asus-numpad || true
    fi
}

pre_remove() {
    if systemctl is-enabled --quiet asus-numpad 2>/dev/null; then
        systemctl disable --now asus-numpad || true
    fi
}
