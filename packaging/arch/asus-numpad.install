# shellcheck shell=bash
# Arch 包的安装钩子（pacman 在 install / upgrade / remove 时调用）
# 注意：这里不用 $1 判断参数名拼写错误，pacman 传的第二个参数是版本号。

post_install() {
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=input --action=change 2>/dev/null || true
    udevadm trigger --subsystem-match=misc --action=change 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable asus-numpad.service 2>/dev/null || true
    systemctl restart asus-numpad.service 2>/dev/null || true

    cat <<'EOF'

asus-numpad 已安装。
  · 长按触摸板右上角图标区约 496ms 切换数字小键盘
    （冰刃双屏 / 灵耀双屏为侧置触摸板，数字模式走键盘上的专用切换键）
  · systemctl status asus-numpad
  · asus-numpad check
  · 配置：/etc/asus-numpad/asus-numpad.json

EOF
}

post_upgrade() {
    udevadm control --reload-rules 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
    systemctl restart asus-numpad.service 2>/dev/null || true
}

pre_remove() {
    systemctl stop asus-numpad.service 2>/dev/null || true
    systemctl disable asus-numpad.service 2>/dev/null || true
}

post_remove() {
    udevadm control --reload-rules 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
}
