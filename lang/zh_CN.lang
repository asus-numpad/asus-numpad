# numdeck 简体中文语言文件
# 键值格式：key = 文案（# 开头为注释，值内可用 \n 换行）
# 缺键会回落到英文内置文案；可复制整份文件到 ~/.config/numdeck/lang/ 做本地化覆盖（免 root）。

# ---- 启动横幅 ----
app.banner = 触摸板小键盘 v{version}（Linux 用户态，参数取自官方 AlgoParameters）

# ---- 命令行总览 ----
cli.about = 触摸板数字小键盘驱动（Linux，官方 AlgoParameters 对齐版）
cli.config.help = 配置文件路径
cli.device.help = 触摸板事件设备；缺省自动探测（义隆 04F3 / 原相 093A 全族，按 HID 模组识别布局）
cli.keyboard.help = 键盘事件设备（读 NumLock LED）
cli.led.help = 背光通道：hidraw / i2c / none
cli.i2c_bus.help = i2c 总线号
cli.i2c_addr.help = i2c 地址（0x38 或 56）
cli.hidraw.help = hidraw 节点（如 /dev/hidraw3）
cli.i2c_transfer.help = i2c 写入工具名
cli.key_mode.help = 键位风格：keypad / digits
cli.layout.help = 布局代号；默认 auto 按触摸板 HID 模组自动识别，numdeck layout 可列出全部代号
cli.numlock.help = NumLock 联动：sync / toggle / off
cli.mixed_mode.help = 混合模式：auto / on / off
cli.no_follow_brightness.help = 关闭「数字区亮度跟随键盘背光」，退回固定 0x01 点亮
cli.grab.help = 抓取触摸板（默认开启）
cli.no_grab.help = 不抓取触摸板（数字区点击会穿透到桌面）
cli.dump_config.help = 打印默认配置后退出
cli.verbose.help = 输出逐帧调试日志（run 模式）
cli.lang.help = 界面语言：zh-CN / zh-TW / en / auto（默认 auto = 跟随系统）

# ---- 子命令说明 ----
cli.cmd.run = 接管触摸板（默认动作）
cli.cmd.check = 自检：打印官方参数、几何换算与键位图，并执行离线用例
cli.cmd.dump = 原样打印触摸板事件（排障用，不产生按键）
cli.cmd.bright = 亮度调节：四档手动调光（0~最大线性可调、可自定义）/ 是否跟随键盘背光
cli.cmd.bright.long = 例：`bright 0|1|2|3|4`（0 = 熄灭，1 = 最暗，4 = 最亮，默认线性等分）、`bright up|down|cycle`（逐档/循环）、`bright follow on|off`、`bright status`；档位可用配置项 `manual_brightness_levels` 自行定义
cli.cmd.bright.value = 档位 0/1/2/3/4（自定义档表时以表长为准），或 up / down / cycle / next / follow / status
cli.cmd.bright.mode = `follow` 的取值：on / off
cli.cmd.levels = 档位表：查看每档字节 / 给某一档指定任意支持亮度 / 恢复默认四档
cli.cmd.levels.long = 例：`levels`（打印当前档表）、`levels 2 0x46`（只改第 2 档，其余档不动，十进制 70 等价）、`levels reset`（恢复默认四档 [0,0x43,0x45,0x48]）；每档可填 0x00（熄灭）或 0x41~0x48 八个亮度值，改完仍须从暗到亮（允许相邻相等）
cli.cmd.levels.step = 档号 1..N（N = 当前档数，最多 8），或 reset / default
cli.cmd.levels.value = 该档下发的亮度：0x00 或 0x41~0x48（十进制、十六进制均可）
cli.cmd.led = 直发背光命令字（排障用，绕过所有状态机）
cli.cmd.led.long = 例：led on | led off | led 0x41..0x48（1..8 档）。用于区分「驱动未发送」与「硬件不接受该值」。
cli.cmd.led.value = on / off / 任意十六进制档位（如 0x41）
led.cmd.usage = 用法：numdeck led on|off|0x41（0x01 亮 / 0x00 灭 / 0x41..0x48 为 1..8 档）
led.cmd.bad_value = 无法识别的取值：{v}（可用 on / off / 0x41 / 65）
cli.cmd.lang = 语言：查看 / 切换界面语言（简体中文、繁體中文、English）
cli.cmd.lang.long = 例：`lang`（查看当前语言与来源）、`lang zh-TW`、`lang en`、`lang auto`（跟随系统）
cli.cmd.lang.code = 语言代码：zh-CN / zh-TW / en / auto

# ---- 命令行参数取值无效时的提示 ----
note.invalid_key_mode = --key-mode={v} 无效，忽略
note.invalid_numlock = --numlock={v} 无效，忽略
note.invalid_mixed_mode = --mixed-mode={v} 无效，忽略
note.invalid_i2c_addr = --i2c-addr={v} 无法解析，忽略
note.invalid_language = language={v} 无法识别，按 auto 处理
note.manual_step_clamped = manual_brightness_step={step} 超出 0..={max}，已收敛到 {max}
note.levels_dropped = brightness_levels 中有 {n} 项超出 0x{lo}..=0x{hi}，已剔除
note.manual_levels_dropped = manual_brightness_levels 中有 {n} 项不是 0（熄灭）且不在 0x{lo}..=0x{hi} 范围内，已剔除
note.manual_levels_not_increasing = manual_brightness_levels 必须从暗到亮（允许相邻两档相等），已放弃自定义、回落到默认四档 [0,0x43,0x45,0x48]
note.manual_levels_truncated = manual_brightness_levels 有 {n} 档，超过硬件上限 {max} 档，已截断
note.manual_levels_reset = manual_brightness_levels 剔除越界值后为空，已放弃自定义、回落到线性等分
note.read_failed = 读取 {path} 失败，使用默认值: {err}
note.config_migrated = 已将旧配置文件 {from} 迁移到 {to}（旧文件保留，可自行删除）

