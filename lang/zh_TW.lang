cli.cmd.layout = 佈局：檢視官方佈局表 / 依 HID 硬體 ID 自動辨識 / 固定佈局
cli.cmd.layout.long = 不帶參數列出全部官方佈局與支援等級；`layout auto` 恢復自動辨識；`layout GH3XLNDZ` 固定佈局；`layout --ids` 列出 HID 硬體 ID 對照表
cli.cmd.layout.name = 佈局名（GH3XLNDZ / GH2XLNDZ / GH4XLNDZ / auto）
cli.cmd.layout.ids = 同時列出觸控板 HID 硬體 ID → 佈局的對照表
cli.sku.help = 手動指定機型設定，跳過自動辨識（機型 id 用 `asus-numpad sku` 查看）
cli.cmd.sku = 機型設定：查看自動辨識結果、列出可選機型、手動指定
cli.cmd.sku.long = 不帶參數時顯示辨識出的機型、判定依據、本機 DMI 身分與觸控板模組；`sku list` 列出全部可選機型；`sku g614` 手動指定；`sku auto` 恢復自動辨識
cli.cmd.sku.id = 機型 id，或 auto / list
layout.current = 目前佈局：設定 {layout}，實際生效 {resolved}（{support}）
layout.list_title = 官方 AsusNUMPADFilter.inf 收錄的佈局（* 已驗證 / ~ 同族、參數照錄但未上實機 / - 無鍵位依據）：
layout.legend = * 已驗證   ~ 同族未驗證（需 --allow-unverified）   - 不支援
layout.ids_title = 觸控板 HID 硬體 ID → 佈局（同 ID 的機型可直接通用）：
layout.usage = 用法：asus-numpad layout                 檢視目前佈局與佈局表
      asus-numpad layout --ids           附帶 HID 硬體 ID 對照表
      asus-numpad layout auto            依觸控板 HID 硬體 ID 自動辨識（建議）
      asus-numpad layout GH3XLNDZ        固定佈局
layout.wrote = 已寫入 {path}：layout_name = {value}（備份 {backup}）
layout.effect_auto = 下次啟動依觸控板 HID 硬體 ID 自動選佈局，辨識不到則回退 GH3XLNDZ
layout.unverified_warn = 注意：佈局 {layout} 為 {support} 等級，鍵位表未經實機驗證
layout.bad_name = 未知佈局名：{v}
note.layout_unknown = layout_name={v} 不在官方佈局表內，按 auto 處理
err.layout_unverified = 佈局 {layout}（{support}）尚未實機驗證，已停止啟動以免按錯鍵。確認可用後加 --allow-unverified。
err.layout_unverified.hint = 放行方式：asus-numpad --allow-unverified run，或在 ~/.config/asus-numpad/asus-numpad.json 裡設 "allow_unverified_layout": true
err.layout_unsupported.hint = 這套鍵表從未在實機上核對過，也沒有鍵位排布依據，直接套用可能按錯鍵；請把 `asus-numpad check` 的輸出回報給維護者以補充核對
dev.report.layout = 佈局：{layout}（{support}，來源 {source}，HID {hid}）

